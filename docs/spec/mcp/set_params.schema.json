{
  "name": "set_params",
  "description": "Set parameter values in params.json, checked against their types and ranges first.",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "values": {
        "additionalProperties": true,
        "description": "Parameter values to keep in params.json. A value equal to its default is dropped from the file.",
        "type": "object"
      }
    },
    "required": [
      "values"
    ],
    "type": "object"
  },
  "output": {
    "$defs": {
      "Details": {
        "description": "Where an error happened and what else helps fix it. Every field is optional.",
        "properties": {
          "excerpt": {
            "description": "The source line, as written.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "The file: relative to the project root for model errors, otherwise the full path.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "description": "1-based line in `file`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestions": {
            "description": "Close matches; part ids for `UNKNOWN_PART` (color and parameter suggestions are in the hint).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "A failure: what happened, where, and what to try.",
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/Details"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The error codes in plan section 09.",
        "enum": [
          "PROJECT_NOT_FOUND",
          "PROJECT_UNTRUSTED",
          "MODEL_EXEC_FAILED",
          "MODEL_TIMEOUT",
          "MODEL_TOO_LARGE",
          "UNKNOWN_PART",
          "UNKNOWN_COLOR",
          "PARAM_INVALID",
          "LIBRARY_MISSING",
          "LIBRARY_CORRUPT",
          "PYTHON_MISSING",
          "RENDER_UNAVAILABLE",
          "IO_ERROR",
          "INTERNAL"
        ],
        "type": "string"
      },
      "Meta": {
        "description": "Facts about the run that produced a result.",
        "properties": {
          "emmet": {
            "description": "The Emmet version.",
            "type": "string"
          },
          "generation": {
            "description": "The project's run counter, after a run.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "inputs_hash": {
            "description": "sha256 of the model's inputs (plan section 07), after a run.",
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "description": "Wall time of the command in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project root, when the command ran in one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "emmet",
          "ms"
        ],
        "type": "object"
      },
      "ParamSpec": {
        "description": "One parameter of the model's schema.",
        "properties": {
          "choices": {
            "items": true,
            "type": [
              "array",
              "null"
            ]
          },
          "default": true,
          "help": {
            "description": "From the model's docstring.",
            "type": "string"
          },
          "line": {
            "description": "The line in `file` that declares it.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "max": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "min": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "step": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "type": {
            "description": "int, float, bool, choice, or color.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "default",
          "help",
          "line"
        ],
        "type": "object"
      },
      "Params": {
        "description": "The model's parameters and their current values.",
        "properties": {
          "changed": {
            "description": "What this call changed (set_params only).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "doc": {
            "description": "The first line of its docstring.",
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "model": {
            "description": "The @model function's name.",
            "type": "string"
          },
          "params": {
            "items": {
              "$ref": "#/$defs/ParamSpec"
            },
            "type": "array"
          },
          "values": {
            "additionalProperties": true,
            "description": "Every parameter's current value: the default, or the override in params.json.",
            "type": "object"
          }
        },
        "required": [
          "model",
          "doc",
          "file",
          "params",
          "values"
        ],
        "type": "object"
      },
      "Warning": {
        "description": "A non-fatal note attached to a success.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Params"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "ok": {
        "type": "boolean"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/Warning"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "warnings",
      "meta"
    ],
    "type": "object"
  }
}
