{
  "name": "highlight",
  "description": "Highlight parts by Emmet id in the open Emmet app's viewer. Says so when the app isn't open.",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "ids": {
        "description": "Emmet ids to highlight in the open app's viewer; an empty list clears the highlight.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "ids"
    ],
    "type": "object"
  },
  "output": {
    "$defs": {
      "Details": {
        "description": "Where an error happened and what else helps fix it. Every field is optional.",
        "properties": {
          "excerpt": {
            "description": "The source line, as written.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "The file: relative to the project root for model errors, otherwise the full path.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "description": "1-based line in `file`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestions": {
            "description": "Close matches; part ids for `UNKNOWN_PART` (color and parameter suggestions are in the hint).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "A failure: what happened, where, and what to try.",
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/Details"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The error codes in plan section 09.",
        "enum": [
          "PROJECT_NOT_FOUND",
          "PROJECT_UNTRUSTED",
          "MODEL_EXEC_FAILED",
          "MODEL_TIMEOUT",
          "MODEL_TOO_LARGE",
          "UNKNOWN_PART",
          "UNKNOWN_COLOR",
          "PARAM_INVALID",
          "LIBRARY_MISSING",
          "LIBRARY_CORRUPT",
          "PYTHON_MISSING",
          "RENDER_UNAVAILABLE",
          "IO_ERROR",
          "INTERNAL"
        ],
        "type": "string"
      },
      "Highlighted": {
        "description": "Whether the open app showed the highlight.",
        "properties": {
          "delivered": {
            "type": "boolean"
          },
          "reason": {
            "description": "Why not, when it wasn't delivered.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "delivered"
        ],
        "type": "object"
      },
      "Meta": {
        "description": "Facts about the run that produced a result.",
        "properties": {
          "emmet": {
            "description": "The Emmet version.",
            "type": "string"
          },
          "generation": {
            "description": "The project's run counter, after a run.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "inputs_hash": {
            "description": "sha256 of the model's inputs (plan section 07), after a run.",
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "description": "Wall time of the command in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project root, when the command ran in one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "emmet",
          "ms"
        ],
        "type": "object"
      },
      "Warning": {
        "description": "A non-fatal note attached to a success.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Highlighted"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "ok": {
        "type": "boolean"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/Warning"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "warnings",
      "meta"
    ],
    "type": "object"
  }
}
