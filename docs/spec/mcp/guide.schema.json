{
  "name": "guide",
  "description": "The build guide: the rules for a scale (micro, figure scale, car 1:8, …) or a style (town, blocky, video game,\n…): proportions, parts, and which techniques to use. With no name, the guides for the project's build settings.\nRead it before the first draft, and again when the build settings change.",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "name": {
        "default": null,
        "description": "A scale, style, or subject, like \"micro\", \"blocky\", or \"vehicles\"; leave it out for the guides for the\nproject's build settings.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "output": {
    "$defs": {
      "Details": {
        "description": "Where an error happened and what else helps fix it. Every field is optional.",
        "properties": {
          "excerpt": {
            "description": "The source line, as written.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "The file: relative to the project root for model errors, otherwise the full path.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "description": "1-based line in `file`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestions": {
            "description": "Close matches; part ids for `UNKNOWN_PART` (color and parameter suggestions are in the hint).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "A failure: what happened, where, and what to try.",
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/Details"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The error codes in plan section 09.",
        "enum": [
          "PROJECT_NOT_FOUND",
          "PROJECT_UNTRUSTED",
          "MODEL_EXEC_FAILED",
          "MODEL_TIMEOUT",
          "MODEL_TOO_LARGE",
          "UNKNOWN_PART",
          "UNKNOWN_COLOR",
          "PARAM_INVALID",
          "LIBRARY_MISSING",
          "LIBRARY_CORRUPT",
          "PYTHON_MISSING",
          "RENDER_UNAVAILABLE",
          "IO_ERROR",
          "INTERNAL"
        ],
        "type": "string"
      },
      "Guide": {
        "properties": {
          "kind": {
            "$ref": "#/$defs/Kind"
          },
          "name": {
            "type": "string"
          },
          "text": {
            "description": "The whole guide, as Markdown.",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "title",
          "text"
        ],
        "type": "object"
      },
      "Guides": {
        "description": "The guides asked for (by name, or the project's scale and style), and the list of every guide when nothing named\none.",
        "properties": {
          "guides": {
            "items": {
              "$ref": "#/$defs/Guide"
            },
            "type": "array"
          },
          "list": {
            "description": "Every guide, when `guides` doesn't cover what the project asks for.",
            "items": {
              "$ref": "#/$defs/Summary"
            },
            "type": "array"
          },
          "note": {
            "description": "What to do about the settings no guide covers: none set, or a style in the user's own words.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Kind": {
        "oneOf": [
          {
            "const": "scale",
            "description": "What the details are sized for (`[build] scale`).",
            "type": "string"
          },
          {
            "const": "style",
            "description": "The look (`[build] style`).",
            "type": "string"
          },
          {
            "const": "subject",
            "description": "A kind of thing in any style: vehicles, interiors, landscaping.",
            "type": "string"
          }
        ]
      },
      "Meta": {
        "description": "Facts about the run that produced a result.",
        "properties": {
          "emmet": {
            "description": "The Emmet version.",
            "type": "string"
          },
          "generation": {
            "description": "The project's run counter, after a run.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "inputs_hash": {
            "description": "sha256 of the model's inputs (plan section 07), after a run.",
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "description": "Wall time of the command in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project root, when the command ran in one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "emmet",
          "ms"
        ],
        "type": "object"
      },
      "Summary": {
        "properties": {
          "kind": {
            "$ref": "#/$defs/Kind"
          },
          "name": {
            "description": "What `guide` takes.",
            "type": "string"
          },
          "title": {
            "description": "Its title.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "title"
        ],
        "type": "object"
      },
      "UserNote": {
        "description": "A message the user typed while the agent worked, attached to an MCP tool result (D-33, plan section 09). Only\n`emmet mcp --session` (the app's chat) ever sets these.",
        "properties": {
          "at": {
            "description": "When the user sent it, as RFC 3339.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "at"
        ],
        "type": "object"
      },
      "Warning": {
        "description": "A non-fatal note attached to a success.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Guides"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "ok": {
        "type": "boolean"
      },
      "user_notes": {
        "description": "What the user just said, newest last. It overrides the current plan (the doctrine says how to handle it).",
        "items": {
          "$ref": "#/$defs/UserNote"
        },
        "type": "array"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/Warning"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "warnings",
      "meta"
    ],
    "type": "object"
  }
}
