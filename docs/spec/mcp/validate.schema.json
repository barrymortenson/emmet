{
  "name": "validate",
  "description": "Check the model: collisions, floating parts, submodels placed off the model, build steps (order and size),\nweak spans, parts a little off the grid, parts or colors never made, and unknown or obsolete parts. Runs the model first if build/ is out\nof date, or with `params` when given. Each finding has an id, the parts, the model.py line that placed them,\nand a hint that says what to change.",
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "params": {
        "additionalProperties": true,
        "default": null,
        "description": "Parameter values to check, on top of params.json, which isn't changed: runs the model with them first. Use it\nto check a slider's other values; params.json is the user's.",
        "type": [
          "object",
          "null"
        ]
      },
      "rules": {
        "default": null,
        "description": "Only these rules (default: all): collision, floating, disconnected_submodel, step_order, step_size,\nweak_connection, off_grid, part_unavailable, color_unavailable, unknown_part, obsolete_part, alias_part.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "output": {
    "$defs": {
      "Allowed": {
        "description": "A finding the project or the model allows (`[[check.allow]]` in emmet.toml, `m.allow`), with its reason.",
        "properties": {
          "parts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reason": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "parts",
          "reason"
        ],
        "type": "object"
      },
      "Checked": {
        "description": "What `validate` returns: the counts, and the first findings (all of them are in build/validation.json).",
        "properties": {
          "allowed": {
            "description": "Findings the project or the model allows (`[[check.allow]]`, `m.allow`), with their reasons.",
            "items": {
              "$ref": "#/$defs/Allowed"
            },
            "type": "array"
          },
          "clean": {
            "description": "No errors and no warnings.",
            "type": "boolean"
          },
          "counts_by_rule": {
            "additionalProperties": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "errors": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "findings": {
            "description": "The first 50, errors first, in source order.",
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "type": "array"
          },
          "only": {
            "description": "The rules checked, when the call named some; empty when every rule ran.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "total": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "warnings": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "counts_by_rule",
          "findings",
          "total",
          "errors",
          "warnings",
          "allowed",
          "clean"
        ],
        "type": "object"
      },
      "Details": {
        "description": "Where an error happened and what else helps fix it. Every field is optional.",
        "properties": {
          "excerpt": {
            "description": "The source line, as written.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "The file: relative to the project root for model errors, otherwise the full path.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "description": "1-based line in `file`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestions": {
            "description": "Close matches; part ids for `UNKNOWN_PART` (color and parameter suggestions are in the hint).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "A failure: what happened, where, and what to try.",
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/Details"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The error codes in plan section 09.",
        "enum": [
          "PROJECT_NOT_FOUND",
          "PROJECT_UNTRUSTED",
          "MODEL_EXEC_FAILED",
          "MODEL_TIMEOUT",
          "MODEL_TOO_LARGE",
          "UNKNOWN_PART",
          "UNKNOWN_COLOR",
          "PARAM_INVALID",
          "LIBRARY_MISSING",
          "LIBRARY_CORRUPT",
          "PYTHON_MISSING",
          "RENDER_UNAVAILABLE",
          "IO_ERROR",
          "INTERNAL"
        ],
        "type": "string"
      },
      "Finding": {
        "description": "One problem with the model (plan section 11's finding shape).",
        "properties": {
          "at": {
            "description": "A point in the DSL frame: x and y in studs, z in plates.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "hint": {
            "type": "string"
          },
          "id": {
            "description": "`F-0001`…, stable for the same inputs.",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "parts": {
            "description": "The Emmet ids of the parts involved.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rule": {
            "$ref": "#/$defs/Rule"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          },
          "source": {
            "description": "Where the model placed them, deduplicated, in source order.",
            "items": {
              "$ref": "#/$defs/Source"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "rule",
          "severity",
          "parts",
          "source",
          "at",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "Meta": {
        "description": "Facts about the run that produced a result.",
        "properties": {
          "emmet": {
            "description": "The Emmet version.",
            "type": "string"
          },
          "generation": {
            "description": "The project's run counter, after a run.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "inputs_hash": {
            "description": "sha256 of the model's inputs (plan section 07), after a run.",
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "description": "Wall time of the command in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project root, when the command ran in one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "emmet",
          "ms"
        ],
        "type": "object"
      },
      "Rule": {
        "description": "The rules (plan section 11), in the order findings with the same severity and source line are listed.",
        "enum": [
          "unknown_part",
          "collision",
          "floating",
          "disconnected_submodel",
          "step_order",
          "step_size",
          "weak_connection",
          "off_grid",
          "part_unavailable",
          "color_unavailable",
          "obsolete_part",
          "alias_part"
        ],
        "type": "string"
      },
      "Severity": {
        "description": "What a finding means for the build.",
        "enum": [
          "error",
          "warning",
          "info"
        ],
        "type": "string"
      },
      "Source": {
        "description": "A line of the model's source that placed a part.",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "file",
          "line"
        ],
        "type": "object"
      },
      "UserNote": {
        "description": "A message the user typed while the agent worked, attached to an MCP tool result (D-33, plan section 09). Only\n`emmet mcp --session` (the app's chat) ever sets these.",
        "properties": {
          "at": {
            "description": "When the user sent it, as RFC 3339.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "at"
        ],
        "type": "object"
      },
      "Warning": {
        "description": "A non-fatal note attached to a success.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Checked"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "ok": {
        "type": "boolean"
      },
      "user_notes": {
        "description": "What the user just said, newest last. It overrides the current plan (the doctrine says how to handle it).",
        "items": {
          "$ref": "#/$defs/UserNote"
        },
        "type": "array"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/Warning"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "warnings",
      "meta"
    ],
    "type": "object"
  }
}
