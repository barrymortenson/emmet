{
  "name": "bom",
  "description": "The parts list: part × color × quantity, with totals, Rebrickable ids, and whether each part was ever made in\nits color. Runs the model first if build/ is out of date.",
  "input": {
    "$defs": {
      "ColorNames": {
        "description": "Whose color names the BOM uses (Settings → Data, `emmet bom --color-names`).",
        "enum": [
          "ldraw",
          "rebrickable",
          "bricklink"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "color_names": {
        "anyOf": [
          {
            "$ref": "#/$defs/ColorNames"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Color names as LDraw, Rebrickable, or BrickLink spell them: ldraw, rebrickable, or bricklink (default: the\nuser's setting)."
      }
    },
    "type": "object"
  },
  "output": {
    "$defs": {
      "Availability": {
        "properties": {
          "sets": {
            "description": "Sets with the part in that color (Rebrickable's inventories); null when unknown.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/Status"
          },
          "years": {
            "description": "The first and last year of those sets; null when there are none.",
            "items": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Bom": {
        "description": "`build/bom.json`.",
        "properties": {
          "color_names": {
            "$ref": "#/$defs/ColorNames"
          },
          "lines": {
            "description": "Most pieces first, then by part id and color.",
            "items": {
              "$ref": "#/$defs/BomLine"
            },
            "type": "array"
          },
          "parts_data": {
            "description": "The parts data pack's version, or null when none is installed.",
            "type": [
              "string",
              "null"
            ]
          },
          "totals": {
            "$ref": "#/$defs/Totals"
          }
        },
        "required": [
          "lines",
          "totals",
          "color_names"
        ],
        "type": "object"
      },
      "BomLine": {
        "properties": {
          "availability": {
            "$ref": "#/$defs/Availability",
            "description": "Whether the part was ever made in that color; `unknown` (never unavailable) without the pack or a mapping."
          },
          "bricklink_color": {
            "description": "BrickLink's color id.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "bricklink_id": {
            "description": "BrickLink's part id, for the wanted list.",
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "description": "The LDraw color code.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "color_name": {
            "description": "The color's name in the BOM's naming (LDraw's when the other has no name for it).",
            "type": "string"
          },
          "name": {
            "description": "The LDraw part's name.",
            "type": "string"
          },
          "part": {
            "description": "The LDraw part id.",
            "type": "string"
          },
          "qty": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "rebrickable_color": {
            "description": "Rebrickable's color id.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "rebrickable_id": {
            "description": "Rebrickable's part id; null without the parts data pack or a mapping.",
            "type": [
              "string",
              "null"
            ]
          },
          "rebrickable_name": {
            "description": "Rebrickable's name for the part.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "part",
          "name",
          "color",
          "color_name",
          "qty",
          "availability"
        ],
        "type": "object"
      },
      "ColorNames": {
        "description": "Whose color names the BOM uses (Settings → Data, `emmet bom --color-names`).",
        "enum": [
          "ldraw",
          "rebrickable",
          "bricklink"
        ],
        "type": "string"
      },
      "Details": {
        "description": "Where an error happened and what else helps fix it. Every field is optional.",
        "properties": {
          "excerpt": {
            "description": "The source line, as written.",
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "description": "The file: relative to the project root for model errors, otherwise the full path.",
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "description": "1-based line in `file`.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "suggestions": {
            "description": "Close matches; part ids for `UNKNOWN_PART` (color and parameter suggestions are in the hint).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "description": "A failure: what happened, where, and what to try.",
        "properties": {
          "code": {
            "$ref": "#/$defs/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "$ref": "#/$defs/Details"
              },
              {
                "type": "null"
              }
            ]
          },
          "hint": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "hint"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "The error codes in plan section 09.",
        "enum": [
          "PROJECT_NOT_FOUND",
          "PROJECT_UNTRUSTED",
          "MODEL_EXEC_FAILED",
          "MODEL_TIMEOUT",
          "MODEL_TOO_LARGE",
          "UNKNOWN_PART",
          "UNKNOWN_COLOR",
          "PARAM_INVALID",
          "LIBRARY_MISSING",
          "LIBRARY_CORRUPT",
          "PYTHON_MISSING",
          "RENDER_UNAVAILABLE",
          "IO_ERROR",
          "INTERNAL"
        ],
        "type": "string"
      },
      "Meta": {
        "description": "Facts about the run that produced a result.",
        "properties": {
          "emmet": {
            "description": "The Emmet version.",
            "type": "string"
          },
          "generation": {
            "description": "The project's run counter, after a run.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "inputs_hash": {
            "description": "sha256 of the model's inputs (plan section 07), after a run.",
            "type": [
              "string",
              "null"
            ]
          },
          "ms": {
            "description": "Wall time of the command in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "project": {
            "description": "The project root, when the command ran in one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "emmet",
          "ms"
        ],
        "type": "object"
      },
      "Status": {
        "description": "Whether a part was ever made in a color.",
        "oneOf": [
          {
            "const": "available",
            "description": "Rebrickable has an element or a set with the part in that color.",
            "type": "string"
          },
          {
            "const": "color_unavailable",
            "description": "The part was made, but never in that color.",
            "type": "string"
          },
          {
            "const": "part_unavailable",
            "description": "Rebrickable knows the part but has no element or set with it in any color.",
            "type": "string"
          },
          {
            "const": "unknown",
            "description": "No pack, or the part or color has no Rebrickable mapping. Never read as unavailable.",
            "type": "string"
          }
        ]
      },
      "Totals": {
        "properties": {
          "lines": {
            "description": "Lines (part × color).",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "parts": {
            "description": "Different parts, in any color.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "pieces": {
            "description": "Pieces in all.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "pieces",
          "lines",
          "parts"
        ],
        "type": "object"
      },
      "UserNote": {
        "description": "A message the user typed while the agent worked, attached to an MCP tool result (D-33, plan section 09). Only\n`emmet mcp --session` (the app's chat) ever sets these.",
        "properties": {
          "at": {
            "description": "When the user sent it, as RFC 3339.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "at"
        ],
        "type": "object"
      },
      "Warning": {
        "description": "A non-fatal note attached to a success.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/Bom"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "ok": {
        "type": "boolean"
      },
      "user_notes": {
        "description": "What the user just said, newest last. It overrides the current plan (the doctrine says how to handle it).",
        "items": {
          "$ref": "#/$defs/UserNote"
        },
        "type": "array"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/Warning"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "warnings",
      "meta"
    ],
    "type": "object"
  }
}
