* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
# LDraw part files keep their CRLF line endings byte for byte (ADR 0003; scripts/ldraw-mini-check.mjs).
tests/fixtures/ldraw-mini/** -text
# The OMR models too: unmodified, as LDraw publishes them (ADR 0003).
tests/fixtures/omr/*.mpd -text
# Keys and other raw bytes: random bytes can look like text, and a line-ending change would break them.
*.der binary
tests/fixtures/parts-data/*.pub binary
