{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: its typed commands by name (the project, the viewer, first-run setup with the agents' install and sign-in, and the chat), and listening for the host's events. Its window's own title row may minimize, maximize, close, and drag it, and read whether it's maximized (Windows draws the caption buttons, D-29). No fs, shell, or dialog permissions; the host opens dialogs and runs the agents itself.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "allow-app-info",
    "allow-ui-state",
    "allow-open-dialog",
    "allow-open-recent",
    "allow-new-project",
    "allow-trust-project",
    "allow-set-build-settings",
    "allow-allow-finding",
    "allow-unallow-finding",
    "allow-keep-params",
    "allow-reset-params",
    "allow-save-version",
    "allow-list-versions",
    "allow-version-scene",
    "allow-restore-version",
    "allow-open-version-as-new",
    "allow-export",
    "allow-reveal-export",
    "allow-get-prefs",
    "allow-set-prefs",
    "allow-pick-projects-folder",
    "allow-cli-status",
    "allow-install-cli",
    "allow-diagnostics",
    "allow-report-problem",
    "allow-get-params",
    "allow-set-params",
    "allow-list-colors",
    "allow-data-settings",
    "allow-set-color-names",
    "allow-rebuild",
    "allow-bus-reply",
    "allow-setup",
    "allow-agent-install",
    "allow-claude-sign-in",
    "allow-agent-cancel",
    "allow-provider-notice",
    "allow-provider-notice-seen",
    "allow-open-terminal",
    "allow-open-plans",
    "allow-agents",
    "allow-chat-start",
    "allow-chat-send",
    "allow-chat-steer",
    "allow-chat-note",
    "allow-chat-stop",
    "allow-chat-respond",
    "allow-chat-answer",
    "allow-chat-state",
    "allow-chat-end",
    "allow-usage",
    "allow-openai-key-saved",
    "allow-openai-key-set",
    "allow-chatgpt-state",
    "allow-chatgpt-sign-in",
    "allow-chatgpt-cancel",
    "allow-chatgpt-sign-out",
    "allow-chatgpt-choose",
    "allow-chatgpt-notice-seen",
    "allow-open-chatgpt-usage"
  ]
}
