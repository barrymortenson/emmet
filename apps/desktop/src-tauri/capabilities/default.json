{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: its typed commands by name (the project, the viewer, first-run setup, and the chat), and listening for the host's events. No fs, shell, or dialog permissions; the host opens dialogs and runs the agents itself.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-ui-state",
    "allow-open-dialog",
    "allow-new-project-dialog",
    "allow-open-recent",
    "allow-get-params",
    "allow-set-params",
    "allow-list-colors",
    "allow-rebuild",
    "allow-bus-reply",
    "allow-setup",
    "allow-agents",
    "allow-chat-start",
    "allow-chat-send",
    "allow-chat-steer",
    "allow-chat-note",
    "allow-chat-stop",
    "allow-chat-respond",
    "allow-chat-answer",
    "allow-chat-state",
    "allow-chat-end",
    "allow-usage",
    "allow-openai-key-saved",
    "allow-openai-key-set"
  ]
}
