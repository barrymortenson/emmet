#!/usr/bin/env node
// SPDX-License-Identifier: AGPL-3.0-or-later
// Scrubs a recorded agent transcript (JSON lines) so it can be committed as a replay fixture (plan section 10).
//
//   scripts/scrub-transcript <in.jsonl> <out.jsonl> [--path <abs path>=<TOKEN>]... [--redact <word>]...
//
// Every string value and key is rewritten, so the output stays valid JSON. Streaming deltas are scrubbed joined, since a
// path or a token can be split across chunks: when a joined Claude content block or Codex item changes, the first
// chunk gets the scrubbed text and the rest become empty, so the joined content is still exact.
//   paths    --path mappings, then 0B spike workspaces (<WS>), the home directory (<HOME>), temp dirs (<TMP>)
//   names    the username and hostname (<USER>, <HOST>), plus each --redact word (<REDACTED>)
//   secrets  anything shaped like an API key, token, or JWT, any value under a token-like key, and email addresses
//   ids      Anthropic message ids (msg_…) become msg_0001, msg_0002, … per file: they aren't secret, but gitleaks'
//            generic-api-key rule flags them under "api_message_id", and replay doesn't need the real values
// The output is byte-identical when scrubbed again. Fails if the input has a line that isn't JSON.

import { readFileSync, realpathSync, writeFileSync } from "node:fs";
import { homedir, hostname, tmpdir, userInfo } from "node:os";
import { pathToFileURL } from "node:url";

const esc = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const real = (p) => {
  try {
    return realpathSync(p);
  } catch {
    return p;
  }
};
// A path as it appears in a transcript: as given, resolved, without macOS's /private, with forward slashes, and the
// way Claude Code encodes a directory into a folder name (every non-alphanumeric character becomes "-").
const variants = (p) => {
  const base = [p, real(p), p.replace(/^\/private/, ""), p.replace(/\\/g, "/")];
  return [...new Set([...base, ...base.map((v) => v.replace(/[^A-Za-z0-9]/g, "-"))])].filter((v) => v.length > 1);
};

export function rules({ paths = [], redact = [] } = {}) {
  const r = [];
  for (const [from, to] of paths) for (const v of variants(from)) r.push([new RegExp(esc(v), "g"), to]);
  // 0B spike workspaces: <tmp>/emmet-spike-<scenario>-XXXXXX
  r.push([/(?:[A-Za-z]:)?[\\/][^\s"'<>]*?[\\/]emmet-spike-[a-z0-9-]+-[A-Za-z0-9]{6}/g, "<WS>"]);
  // Longest first, so a temp dir inside the home directory becomes <TMP>, not <HOME>/….
  const dirs = [...variants(tmpdir()).map((v) => [v, "<TMP>"]), ...variants(homedir()).map((v) => [v, "<HOME>"])];
  for (const [v, to] of dirs.sort((a, b) => b[0].length - a[0].length)) r.push([new RegExp(esc(v), "g"), to]);
  r.push([/(?:\/private)?\/var\/folders\/[^/\s"']+\/[^/\s"']+\/T(?=[/\s"']|$)/g, "<TMP>"]);
  r.push([/-(?:private-)?var-folders-[A-Za-z0-9]{2}-[A-Za-z0-9-]{20,40}-T(?=-|$|[\s"'])/g, "<TMP>"]);
  r.push([/(?:\/private)?\/tmp(?=\/)/g, "<TMP>"]);
  // Secrets before names, so a username inside a token can't split it.
  r.push([/sk-ant-[A-Za-z0-9_*-]{8,}/g, "<REDACTED>"]);
  r.push([/sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_*-]{16,}/g, "<REDACTED>"]);
  r.push([/eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/g, "<REDACTED>"]);
  r.push([/\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|xox[abpr]-[A-Za-z0-9-]{10,})\b/g, "<REDACTED>"]);
  r.push([/\b(Bearer|Basic)\s+[A-Za-z0-9._~+/-]{16,}=*/g, "$1 <REDACTED>"]);
  r.push([/[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}/g, "<EMAIL>"]);
  const host = hostname();
  // The full hostname always; its first label only when it's long enough not to be a common word ("Mac").
  for (const h of new Set([host, host.split(".")[0]])) if (h === host ? h.length > 2 : h.length >= 6) r.push([new RegExp(`\\b${esc(h)}\\b`, "gi"), "<HOST>"]);
  const user = userInfo().username;
  if (user.length > 2) r.push([new RegExp(`\\b${esc(user)}\\b`, "gi"), "<USER>"]);
  for (const w of redact) r.push([new RegExp(`\\b${esc(w)}\\b`, "gi"), "<REDACTED>"]);
  return r;
}

const SECRET_KEY = /^(api[_-]?key|access[_-]?token|refresh[_-]?token|id[_-]?token|auth[_-]?token|authorization|password|secret|client[_-]?secret|ws[_-]?token)$/i;

export function scrubValue(v, r) {
  if (typeof v === "string") {
    let s = v;
    for (const [re, to] of r) s = s.replace(re, to);
    return s;
  }
  if (Array.isArray(v)) return v.map((x) => scrubValue(x, r));
  if (v && typeof v === "object") {
    const o = {};
    for (const [k, x] of Object.entries(v))
      o[scrubValue(k, r)] = SECRET_KEY.test(k) && typeof x === "string" && x ? "<REDACTED>" : scrubValue(x, r);
    return o;
  }
  return v;
}

/** The streaming chunks in a transcript, grouped per Claude content block or Codex item, as [holder, key] pairs. */
function deltaGroups(lines) {
  const groups = new Map();
  let message = 0;
  for (const line of lines) {
    const m = line?.msg;
    if (!m || typeof m !== "object") continue;
    const ev = m.type === "stream_event" ? m.event : null;
    if (ev?.type === "message_start") message++;
    if (ev?.type === "content_block_delta" && ev.delta) {
      const key = ["partial_json", "text", "thinking"].find((k) => typeof ev.delta[k] === "string");
      if (key) {
        const g = `claude|${m.session_id}|${message}|${ev.index}|${key}`;
        if (!groups.has(g)) groups.set(g, []);
        groups.get(g).push([ev.delta, key]);
      }
    }
    if (typeof m.method === "string" && /delta$/i.test(m.method) && typeof m.params?.delta === "string") {
      const g = `codex|${m.method}|${m.params.itemId}|${m.params.summaryIndex ?? m.params.contentIndex ?? ""}`;
      if (!groups.has(g)) groups.set(g, []);
      groups.get(g).push([m.params, "delta"]);
    }
  }
  return [...groups.values()];
}

export function scrubText(text, opts) {
  const ids = new Map();
  const r = [...rules(opts), [/\bmsg_[A-Za-z0-9]{20,}\b/g, (id) => ids.get(id) ?? (ids.set(id, `msg_${String(ids.size + 1).padStart(4, "0")}`), ids.get(id))]];
  const lines = text
    .split("\n")
    .filter((l) => l.trim())
    .map((l, i) => {
      try {
        return JSON.parse(l);
      } catch {
        throw new Error(`line ${i + 1} is not JSON`);
      }
    });
  for (const pieces of deltaGroups(lines)) {
    const joined = pieces.map(([o, k]) => o[k]).join("");
    const clean = scrubValue(joined, r);
    if (clean === joined) continue;
    pieces.forEach(([o, k], i) => (o[k] = i === 0 ? clean : ""));
  }
  return lines.map((obj) => JSON.stringify(scrubValue(obj, r))).join("\n") + "\n";
}

if (process.argv[1] && import.meta.url === pathToFileURL(real(process.argv[1])).href) {
  const pos = [];
  const paths = [];
  const redact = [];
  const argv = process.argv.slice(2);
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === "--path") {
      const [from, to] = argv[++i].split(/=(?=[^=]*$)/);
      paths.push([from, to]);
    } else if (argv[i] === "--redact") redact.push(argv[++i]);
    else pos.push(argv[i]);
  }
  if (pos.length !== 2) {
    console.error("usage: scrub-transcript <in.jsonl> <out.jsonl> [--path <abs>=<TOKEN>]... [--redact <word>]...");
    process.exit(2);
  }
  try {
    const out = scrubText(readFileSync(pos[0], "utf8"), { paths, redact });
    writeFileSync(pos[1], out);
    console.log(`scrub-transcript: ${pos[1]} (${out.split("\n").length - 1} lines, ${Buffer.byteLength(out)} bytes)`);
  } catch (e) {
    console.error(`scrub-transcript: ${pos[0]}: ${e.message}`);
    process.exit(1);
  }
}
