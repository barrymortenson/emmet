#!/usr/bin/env node
// SPDX-License-Identifier: AGPL-3.0-or-later
// Builds tests/fixtures/rebrickable-mini/ from a pinned Rebrickable catalog download (plan section 12, ADR 0004):
// the rows the ldraw-mini parts need, the color tables, and the inventories of the rung 3 shortlist sets, with the
// credit Rebrickable asks for. Tests use it so they never touch the network. Run by hand when the pin changes:
//
//   for f in colors color_mappings parts part_categories part_mappings part_relationships elements sets \
//            inventories inventory_parts themes; do
//     curl -fLo <empty dir>/$f.csv.gz https://cdn.rebrickable.com/media/downloads/$f.csv.gz; done
//   scripts/make-rebrickable-mini <that dir>
//
// Rebrickable allows automated downloads of these files at most once a day.

import { createHash } from "node:crypto";
import { mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { gunzipSync } from "node:zlib";
import { csv, csvLine } from "./lib/csv.mjs";

const PIN = {
  date: "2026-10-24",
  sha256: {
    colors: "8eafe535e3e2d7dd46ee9349335c52c680509016b7fdf83bac67082b4ec9babe",
    color_mappings: "b6b6fc42f14184caf2a160d71642a225fa37ea64e094419a5fb4e0566a84b7a4",
    parts: "8c3cd699daab3ca7dac0d71003d0cf81fb9215122741ae40703e41671d15fa59",
    part_categories: "1d79a237708014aecfd4eadcc5a5db8cb20efe8b9f9d3f105ec2c8d9328cefc6",
    part_mappings: "1d2ba5431f87a864427f8a1c5c79f80403adcadd6f75189aa50e9999136f60ec",
    part_relationships: "77197478b8af96a48964ac91b37983fffebdfb63183f2826da64f56bb961d03d",
    elements: "93a686f4d84516c25936e5d1b2c55511a96a89e6167c0eb0e36064cde86ddce4",
    sets: "877c7b7b0c86a86cd9d334c96c0932163d948244bc04f7da38dfe90cd2657fed",
    inventories: "0564a6b8ab3d5fa53ff9029ae84ca43e0f265c2e9a8f909bd17cf230ec3eacb8",
    inventory_parts: "01c3b8a9b81c06ceaf018485a4f12b0c5639d0799f7116f96f3e3808e03b968b",
    themes: "fb2cd32e4c52ef1db1fdda53c61e26fe00204612ef9df40e5f38980d391f3053",
  },
};
// The rung 3 shortlist (docs/spec/ladder.md): their Rebrickable inventories are the BOM ground truth.
const SETS = ["40182-1", "40142-1", "21022-1", "21013-1", "6743-1"];
const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const OUT = join(ROOT, "tests/fixtures/rebrickable-mini");
const MINI = join(ROOT, "tests/fixtures/ldraw-mini");

const dir = process.argv[2];
if (!dir) {
  console.error("usage: scripts/make-rebrickable-mini <dir with the Rebrickable .csv.gz files>");
  process.exit(2);
}
const raw = {};
for (const [name, want] of Object.entries(PIN.sha256)) {
  const buf = readFileSync(join(dir, `${name}.csv.gz`));
  const got = createHash("sha256").update(buf).digest("hex");
  if (got !== want) {
    console.error(`make-rebrickable-mini: ${name}.csv.gz has sha256 ${got}, not the ${PIN.date} pin.`);
    console.error("Update PIN in this script (date and every hash) when moving to a new download.");
    process.exit(1);
  }
  raw[name] = gunzipSync(buf).toString("utf8");
}
const t = Object.fromEntries(Object.entries(raw).map(([k, v]) => [k, csv(v)]));
const header = (name) => raw[name].slice(0, raw[name].indexOf("\n")).replace(/\r$/, "").split(",");
const NEEDED = {
  parts: ["part_num"],
  part_mappings: ["part_num", "ext_system", "ext_id", "is_import_id"],
  part_relationships: ["child_part_num", "parent_part_num"],
  elements: ["part_num"],
  color_mappings: ["ext_system"],
  sets: ["set_num"],
  inventories: ["id", "set_num"],
  inventory_parts: ["inventory_id", "part_num", "color_id", "is_spare"],
};
for (const [name, cols] of Object.entries(NEEDED))
  for (const c of cols) if (!header(name).includes(c)) throw new Error(`${name}.csv has no ${c} column`);

// ldraw-mini's part files and their titles; the ~ aliases and internal parts are filtered out below.
const mini = readFileSync(join(MINI, "MANIFEST.sha256"), "utf8")
  .split("\n")
  .map((l) => l.slice(66))
  .filter((f) => /^parts\/[^/]+\.dat$/.test(f));
const titles = new Map(mini.map((f) => [f.slice(6, -4).toLowerCase(), readFileSync(join(MINI, f), "latin1").split(/\r?\n/)[0].replace(/^0\s*/, "")]));
const moved = new Map();
for (const [id, title] of titles) {
  const m = title.match(/^~Moved to (\S+)/i);
  if (m) moved.set(m[1].toLowerCase(), [...(moved.get(m[1].toLowerCase()) ?? []), id]);
}

// LDraw id → Rebrickable part_num, by ADR 0004's rules: an LD row, an LD row for a moved id, an identical id, or the
// base of a formed variant (-f1, -f2).
const ld = new Map();
for (const m of t.part_mappings.filter((m) => m.ext_system === "LD")) if (!ld.has(m.ext_id) || m.is_import_id === "True") ld.set(m.ext_id, m.part_num);
const rbIds = new Set(t.parts.map((p) => p.part_num));
const toRb = (id) =>
  ld.get(id) ?? (moved.get(id) ?? []).map((o) => ld.get(o)).find(Boolean) ?? (rbIds.has(id) ? id : null) ?? (/-f\d+$/.test(id) ? toRb(id.replace(/-f\d+$/, "")) : null);
const parts = new Set();
// Only real parts (not ~ moved, obsolete, or internal files, = aliases, or _ physical-color parts).
for (const [id, title] of titles) if (!/^[~=_]/.test(title) && toRb(id)) parts.add(toRb(id));

const inventories = t.inventories.filter((i) => SETS.includes(i.set_num));
const invIds = new Set(inventories.map((i) => i.id));
const lines = t.inventory_parts.filter((l) => invIds.has(l.inventory_id));
// A renamed column or a set that left the catalog would otherwise write a quietly incomplete fixture.
for (const s of SETS) {
  const ids = new Set(inventories.filter((i) => i.set_num === s).map((i) => i.id));
  if (!ids.size || !lines.some((l) => ids.has(l.inventory_id))) throw new Error(`set ${s} has no inventory lines in this download`);
}
if (!parts.size) throw new Error("no ldraw-mini part maps to a Rebrickable part");
for (const l of lines) parts.add(l.part_num);
const colorsUsed = new Set([...lines.map((l) => l.color_id)]);

const cut = {
  colors: t.colors,
  color_mappings: t.color_mappings.filter((m) => m.ext_system === "LD" || m.ext_system === "BL"),
  part_categories: t.part_categories,
  parts: t.parts.filter((p) => parts.has(p.part_num)),
  part_mappings: t.part_mappings.filter((m) => parts.has(m.part_num) && (m.ext_system === "LD" || m.ext_system === "BL")),
  part_relationships: t.part_relationships.filter((r) => parts.has(r.child_part_num) && parts.has(r.parent_part_num)),
  elements: t.elements.filter((e) => parts.has(e.part_num)),
  themes: t.themes,
  sets: t.sets.filter((s) => SETS.includes(s.set_num)),
  inventories,
  inventory_parts: lines,
};

rmSync(OUT, { recursive: true, force: true });
mkdirSync(OUT, { recursive: true });
const counts = [];
for (const [name, rows] of Object.entries(cut)) {
  // Rebrickable's image URLs are dropped (plan section 12: Emmet never hotlinks them).
  const cols = header(name).filter((c) => c !== "img_url");
  writeFileSync(join(OUT, `${name}.csv`), [cols.join(","), ...rows.map((r) => csvLine(cols.map((c) => r[c])))].join("\n") + "\n");
  counts.push(`| ${name}.csv | ${rows.length} | ${t[name].length} |`);
}
writeFileSync(
  join(OUT, "README.md"),
  `# rebrickable-mini

Part, color, and set data from Rebrickable (rebrickable.com).

A cut of Rebrickable's catalog download of ${PIN.date} (https://rebrickable.com/downloads/), which Rebrickable
offers free for personal and commercial use with credit to Rebrickable as the data source. Built by
\`scripts/make-rebrickable-mini\` for tests (plan section 12, ADR 0004): the rows for the ${parts.size} Rebrickable parts
behind ldraw-mini's parts and the rung 3 shortlist sets (${SETS.join(", ")}), all colors and themes, and those sets'
inventories (${colorsUsed.size} colors). The color and part mappings keep only their LDraw (LD) and BrickLink (BL)
rows, and the \`img_url\` columns are dropped; the rows kept are otherwise unchanged.

| File | Rows here | Rows in the download |
|------|-----------|----------------------|
${counts.join("\n")}

Source files (sha256 of each .csv.gz):

${Object.entries(PIN.sha256).map(([k, v]) => `- \`${k}.csv.gz\` \`${v}\``).join("\n")}
`,
);
console.log(`make-rebrickable-mini: ${parts.size} parts, ${lines.length} inventory lines → ${OUT}`);
